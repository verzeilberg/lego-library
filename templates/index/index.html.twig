{% extends 'base.html.twig' %}

{% block title %}Home — API Verzeilberg{% endblock %}

{% block content %}
    <div class="px-4 py-5 my-5 text-center">
        <h1 class="display-4 fw-bold">BRICKS library</h1>
        <p class="lead mb-4">Your personal LEGO library management API</p>
        <p class="col-lg-8 mx-auto text-muted">
            Organize, track, and manage your LEGO collection with ease.
            Browse sets, minifigures, parts, and build custom boards.
        </p>
        <p class="col-lg-8 mx-auto text-muted">
            The mobile app is currently available for Android only.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/api/docs" class="btn btn-primary btn-lg px-4">Swagger UI</a>
            <a href="/api/docs/api" class="btn btn-success btn-lg px-4">API Reference</a>
            <a href="{{ asset('downloads/bricks-library-2.0.apk') }}" class="btn btn-dark btn-lg px-4">Download App v2.0 (.apk)</a>
        </div>
    </div>

    <div class="row g-4 py-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">🧱</div>
                    <h5 class="card-title">Sets</h5>
                    <p class="card-text text-muted">Browse and manage your LEGO sets with detailed metadata, parts, and minifigures.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">📋</div>
                    <h5 class="card-title">Boards</h5>
                    <p class="card-text text-muted">Create custom boards to organize sets by theme, project, or collection.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">🔧</div>
                    <h5 class="card-title">Parts</h5>
                    <p class="card-text text-muted">Track part conditions, identify defects, and keep your inventory accurate.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
