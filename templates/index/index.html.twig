{% extends 'base.html.twig' %}

{% block title %}Home — API Verzeilberg{% endblock %}

{% block content %}
    <div class="px-4 py-5 my-5 text-center">
        <img src="{{ asset('images/bricks-library-logo.png') }}" alt="Bricks Library" width="128" height="128" class="mb-4 rounded-3 shadow-sm">
        <h1 class="display-4 fw-bold">BRICKS library</h1>
        <p class="lead mb-4">Your personal LEGO library management API</p>
        <p class="col-lg-8 mx-auto text-muted">
            Organize, track, and manage your LEGO collection with ease.
            Browse sets, minifigures and parts, build custom boards, track missing parts,
            see how complete your sets are and export what you need to BrickLink.
        </p>
        <p class="col-lg-8 mx-auto text-muted">
            The mobile app is currently available for Android only.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/api/docs" class="btn btn-primary btn-lg px-4">Swagger UI</a>
            <a href="/api/docs/api" class="btn btn-success btn-lg px-4">API Reference</a>
            <a href="{{ asset('downloads/bricks-library-2.1.apk') }}" class="btn btn-dark btn-lg px-4">Download App v2.1 (.apk)</a>
        </div>
    </div>

    <div class="row g-4 py-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">🧱</div>
                    <h5 class="card-title">Sets</h5>
                    <p class="card-text text-muted">Add sets from Rebrickable with parts and minifigures, upload your own photos, rate sets and keep track of whether you still have the building instructions.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">📋</div>
                    <h5 class="card-title">Boards</h5>
                    <p class="card-text text-muted">Organize sets in boards and nested sub-boards, move sets and boards around, and browse or search public boards.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">🔧</div>
                    <h5 class="card-title">Parts</h5>
                    <p class="card-text text-muted">Mark parts as missing, broken or discoloured. Spare parts are tracked separately so they never count against your sets.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">🧍</div>
                    <h5 class="card-title">Minifigures</h5>
                    <p class="card-text text-muted">Track missing minifigures per set, alongside the missing parts.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">📊</div>
                    <h5 class="card-title">Completeness</h5>
                    <p class="card-text text-muted">See how complete every set is, plus board stats for all sets, missing parts and minifigs, including sub-boards.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">🛒</div>
                    <h5 class="card-title">BrickLink export</h5>
                    <p class="card-text text-muted">Export the missing parts of a set or a whole board as a BrickLink wanted list (XML), ready to upload to bricklink.com.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">🤝</div>
                    <h5 class="card-title">Friends & sharing</h5>
                    <p class="card-text text-muted">Add friends, share boards with them and add sets to shared boards together.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">🔔</div>
                    <h5 class="card-title">Notifications</h5>
                    <p class="card-text text-muted">Get push notifications in the app, with per-user notification preferences.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3" style="font-size: 2.5rem;">📱</div>
                    <h5 class="card-title">Android app</h5>
                    <p class="card-text text-muted">Download the Bricks Library app v2.1 to manage your collection on the go.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
