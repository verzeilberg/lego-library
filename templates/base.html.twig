<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}API Verzeilberg{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="{{ path('app_homepage') }}">
                    <img src="{{ asset('images/bricks-library-logo.png') }}" alt="" width="32" height="32" class="me-2 rounded">
                    API Verzeilberg
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_homepage') }}">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/api/docs">API Docs</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container">
            {% block content %}{% endblock %}
        </main>

        <footer class="bg-dark text-light mt-5 py-3">
            <div class="container text-center">
                <p class="mb-0">&copy; {{ 'now'|date('Y') }} API Verzeilberg — LEGO Library API</p>
            </div>
        </footer>
    </body>
</html>
